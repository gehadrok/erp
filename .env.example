# ============ Database ============
# Docker compose maps host 5433 -> container 5432 to avoid clashing with any local postgres
DATABASE_URL=postgres://erp_migrator:erp_migrator_pw@localhost:5433/erp
# Role used by the API at runtime (RLS applies)
APP_DATABASE_URL=postgres://erp_app:erp_app_pw@localhost:5433/erp
DB_ROLES_PASSWORD=rls_holder_pw
# Tests use testcontainers; override here only if needed
DB_TEST_IMAGE=postgres:16

# ============ App ============
PORT=3000
NODE_ENV=development
