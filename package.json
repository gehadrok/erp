{
  "name": "erp-backend",
  "version": "0.1.0",
  "description": "ERP accounting system - backend (NestJS + TypeORM + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"migrations/**/*.ts\"",
    "test": "jest",
    "test:db": "jest --runInBand --selectProjects db",
    "test:unit": "jest --selectProjects unit",
    "migration:generate": "typeorm-ts-node-esm migration:generate -d src/database/data-source.ts",
    "migration:create": "typeorm-ts-node-esm migration:create",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-esm migration:show -d synchronize=false",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/run-seeds.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "rootDir": ".",
        "testRegex": "\\.spec\\.ts$",
        "testPathIgnorePatterns": ["/node_modules/", "\\.db\\.spec\\.ts$"],
        "moduleFileExtensions": ["js", "json", "ts"],
        "transform": { "^.+\\.ts$": "ts-jest" },
        "testEnvironment": "node"
      },
      {
        "displayName": "db",
        "rootDir": ".",
        "testRegex": "\\.db\\.spec\\.ts$",
        "moduleFileExtensions": ["js", "json", "ts"],
        "transform": { "^.+\\.ts$": "ts-jest" },
        "testEnvironment": "node",
        "testTimeout": 120000
      }
    ]
  }
}
